# from the repo's base directory, build image with:
#    docker buildx build -t dadossurdos_rstudio -f docker/RStudio_Dockerfile .

# run ETL from within the container with
#    docker run -it --rm -p 8787:8787 -e DISABLE_AUTH=true -v /tmp/etl/br_ibge_pns_2019/data/microdata.parquet:/tmp/etl/br_ibge_pns_2019/data/microdata.parquet dadossurdos_rstudio

# alternatively with
#    docker run -it --rm -p 8787:8787 -e DISABLE_AUTH=true dadossurdos_rstudio

FROM rocker/tidyverse:4.4.1

# Ingest IBGE/PNS2019 processed data into container
ENV br_ibge_pns_2019=/tmp/etl/br_ibge_pns_2019/data
COPY $br_ibge_pns_2019/microdata.parquet $br_ibge_pns_2019/variables_dictionary.txt $br_ibge_pns_2019
